{
  "name": "@designflow/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "typecheck:browser": "tsc -p tsconfig.browser.json --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run tests"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
