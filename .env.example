# Required: Supabase project API URL (http://127.0.0.1:54321 for the local stack).
SUPABASE_URL=
# Required: public anon API key. Safe for the later browser client.
SUPABASE_ANON_KEY=
# Required: server-only service role key. Never place in frontend environment variables.
SUPABASE_SERVICE_ROLE_KEY=
# Required only in production: Sentry project DSN.
SENTRY_DSN=
# Optional: development, test, or production. Defaults to development.
NODE_ENV=
# Optional: listen port, defaults to 3001.
PORT=
# Optional: listen address, defaults to 127.0.0.1.
HOST=
# Optional: comma-separated exact frontend origins; defaults to http://localhost:5173.
CORS_ORIGINS=
# Optional: Pino level; defaults to info.
LOG_LEVEL=
