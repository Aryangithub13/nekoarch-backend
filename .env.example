# API credentials: public anon key only; never deploy a service-role key to the API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only local Supabase acceptance/setup tooling needs this administrative key.
SUPABASE_SERVICE_ROLE_KEY=
# Sentry DSN required in production. Never use a real DSN in local tests.
SENTRY_DSN=
# Optional safe release identifier, e.g. backend-v1-phase8 or a commit SHA.
RELEASE=
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Exact origins. Empty defaults to localhost:5173 in development/test; denies all browser origins in production.
CORS_ORIGINS=
# Empty ignores forwarded headers. Set only known proxy IPs/CIDRs; never 'true' or a hop count.
TRUST_PROXY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=30
RATE_LIMIT_GENERATE=10
# Per-address guard before Auth calls; authenticated operation quotas above are per user.
RATE_LIMIT_IP=300
BODY_LIMIT_BYTES=1048576
SMALL_BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
CONNECTION_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
UPSTREAM_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000
# Enable only for production served exclusively through HTTPS termination.
HSTS_ENABLED=false

# Native V2 QA attestation: provision from project_private.commit_key using an
# administrative DB connection and your secret manager. Never expose to clients.
# Missing key disables revision writes (V1 and project metadata remain available).
PROJECT_COMMIT_SECRET=

# Free local interpretation; no external AI credentials or provider required.
AI_INTERPRETER_MODE=fallback
AI_INTERPRETER_TIMEOUT_MS=5000
AI_INTERPRETER_MAX_OUTPUT_TOKENS=2048

# Phase 20: no inference service needed for fallback. Local mode accepts only
# http://127.0.0.1:<port>/v1/chat/completions or numeric IPv6 loopback.
AI_CONVERSATION_MODE=fallback
AI_CONVERSATION_ENDPOINT=
AI_CONVERSATION_MODEL=
AI_CONVERSATION_API_KEY=
