# API credentials: public anon key only; never deploy a service-role key to the API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Tooling only (local Supabase acceptance and setup scripts); the API never reads it. Leave it out of API deployments.
SUPABASE_SERVICE_ROLE_KEY=
# Sentry DSN required in production. Never use a real DSN in local tests.
SENTRY_DSN=
# Optional safe release identifier, e.g. backend-v1-phase8 or a commit SHA.
RELEASE=
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Exact origins. Empty defaults to localhost:5173 in development/test. Required in production: list the frontend's
# origins, or `none` to allow no browser origin (an empty value refuses to start).
CORS_ORIGINS=
# Empty ignores forwarded headers. Set only known proxy IPs/CIDRs; never 'true' or a hop count. Behind a load
# balancer or PaaS proxy, set its addresses: otherwise every user shares one RATE_LIMIT_IP bucket.
TRUST_PROXY=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=30
RATE_LIMIT_GENERATE=10
# Per-address guard before Auth calls; authenticated operation quotas above are per user.
RATE_LIMIT_IP=300
BODY_LIMIT_BYTES=1048576
SMALL_BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=30000
CONNECTION_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
UPSTREAM_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000
# Enable only for production served exclusively through HTTPS termination.
HSTS_ENABLED=false

# Native V2 QA attestation: provision from project_private.commit_key using an
# administrative DB connection and your secret manager. Never expose to clients.
# Missing key disables revision writes (V1 and project metadata remain available).
# It must equal THIS database's key: every `supabase db reset` regenerates it. For the
# local stack, `npm run db:secret` prints the current value. A stale value makes
# /health/ready 503 and signed writes 503 COMMIT_ATTESTATION_UNAVAILABLE.
PROJECT_COMMIT_SECRET=

# Free local interpretation; no external AI credentials or provider required.
AI_INTERPRETER_MODE=fallback
AI_INTERPRETER_TIMEOUT_MS=5000
AI_INTERPRETER_MAX_OUTPUT_TOKENS=2048

# Phase 20: no inference service needed for fallback. Local mode accepts only
# http://127.0.0.1:<port>/v1/chat/completions or numeric IPv6 loopback.
AI_CONVERSATION_MODE=fallback
AI_CONVERSATION_ENDPOINT=
AI_CONVERSATION_MODEL=
AI_CONVERSATION_API_KEY=

# Phase 21: optional server-owned JSON policy; empty preserves Phase 20 settings.
# Default privacy is LOCAL_ONLY, deterministic fallback enabled, no providers required.
# See docs/phase21-design.md for model/provider configuration and remote restrictions.
AI_ROUTING_CONFIG=
# Optional remote credentials use referenced AI_PROVIDER_<NAME>_API_KEY variables.

# Phase 36: optional server-owned compute policy (JSON). Empty keeps the local worker
# pool only; enabling remote execution fails startup in this release (fail closed).
COMPUTE_POLICY=

# Not read by the API. Operator and test scripts only:
#   HOSTED_DB_URL (read-only role; scripts/verify-hosted-migrations.mjs),
#   STAGING_API_URL, STAGING_OWNER_TOKEN, STAGING_OTHER_TOKEN, STAGING_CONFIRM (staging workflow scripts),
#   UPDATE_ROUTE_CATALOG=1 (regenerates docs/modernization/*.json), B46_TIMINGS_FILE.
# The frontend needs SUPABASE_URL and SUPABASE_ANON_KEY (the same public values) plus
# this API's base URL; it never needs PROJECT_COMMIT_SECRET or a service-role key.
